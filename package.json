{
	"name": "tsasm",
	"version": "2.0.0",
	"type": "module",
	"author": "kktos",
	"description": "Multi CPU assembler in typescript. Either as a CLI or a library.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kktos/tsasm.git"
	},
	"main": "tsasm.js",
	"bin": {
		"asm6502": "tsasm.js"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"build": "npm run --silent version:bump && rimraf ./dist && rollup -c rollup.config.js",
		"build:cli": "npm run --silent version:bump && rollup -c rollup.config.js --environment TARGET:cli",
		"build:lib": "npm run --silent version:bump && rollup -c rollup.config.js --environment TARGET:lib",
		"version:bump": "npm version patch --no-git-tag-version",
		"install:cli": "node scripts/install-cli.js",
		"uninstall:cli": "node scripts/install-cli.js --uninstall",
		"test": "vitest",
		"lint:ci": "biome ci ./src",
		"lint:fix": "biome check --write --unsafe ./src",
		"format:fix": "biome format --write ./src",
		"publishIt": "cd dist && npm publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24.10.1",
		"@vitest/ui": "^4.0.13",
		"rimraf": "^6.1.2",
		"rollup": "^4.53.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vitest": "^4.0.13"
	},
	"dependencies": {
		"js-yaml": "^4.1.1"
	}
}
