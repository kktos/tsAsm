{
	"name": "tsasm",
	"displayName": "tsAsm",
	"version": "0.1.0",
	"description": "The tsAsm assembler's language: syntax colouring, the projects' errors in the Problems panel, go to a definition, hovers and references, and links to the files a source includes.",
	"categories": [
		"Programming Languages"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kktos/tsAsm.git",
		"directory": "editors/vscode"
	},
	"publisher": "kktos",
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "tsasm",
				"aliases": [
					"tsAsm"
				],
				"extensions": [
					".asm"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "tsasm",
				"scopeName": "source.tsasm",
				"path": "./dist/tsasm.tmLanguage.json",
				"embeddedLanguages": {
					"meta.embedded.block.yaml": "yaml",
					"meta.embedded.block.json": "json"
				}
			}
		],
		"configuration": {
			"title": "tsAsm",
			"properties": {
				"tsasm.project": {
					"type": [
						"string",
						"array"
					],
					"items": {
						"type": "string"
					},
					"default": [],
					"markdownDescription": "The project files to assemble, relative to the workspace folder: `\"build/game.yaml\"`, or a list. Left empty, every YAML file with an `input.source` is one."
				}
			}
		}
	},
	"activationEvents": [
		"workspaceContains:**/*.asm"
	],
	"engines": {
		"vscode": "^1.75.0"
	}
}
