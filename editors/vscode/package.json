{
	"name": "tsasm",
	"displayName": "tsAsm",
	"version": "0.1.0",
	"description": "The tsAsm assembler's language: syntax colouring from the grammar and the assembly, the projects' errors in the Problems panel, go to a definition, hovers, references, completion and signature help, rename, folding and the outline, the listing beside a file, and links to the files a source includes.",
	"categories": [
		"Programming Languages"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kktos/tsAsm.git",
		"directory": "editors/vscode"
	},
	"publisher": "kktos",
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "tsasm.showListing",
				"title": "Show Listing",
				"category": "tsAsm",
				"icon": "$(list-flat)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "tsasm.showListing",
					"when": "editorLangId == tsasm"
				}
			],
			"editor/title": [
				{
					"command": "tsasm.showListing",
					"when": "editorLangId == tsasm",
					"group": "navigation"
				}
			]
		},
		"languages": [
			{
				"id": "tsasm",
				"aliases": [
					"tsAsm"
				],
				"extensions": [
					".asm"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "tsasm",
				"scopeName": "source.tsasm",
				"path": "./dist/tsasm.tmLanguage.json",
				"embeddedLanguages": {
					"meta.embedded.block.yaml": "yaml",
					"meta.embedded.block.json": "json"
				}
			}
		],
		"configuration": {
			"title": "tsAsm",
			"properties": {
				"tsasm.project": {
					"type": [
						"string",
						"array"
					],
					"items": {
						"type": "string"
					},
					"default": [],
					"markdownDescription": "The project files to assemble, relative to the workspace folder: `\"build/game.yaml\"`, or a list. Left empty, every YAML file with an `input.source` is one."
				}
			}
		},
		"semanticTokenModifiers": [
			{
				"id": "local",
				"description": "A local label: `:loop`, with the prefix `.option local.prefix` sets."
			},
			{
				"id": "anonymous",
				"description": "An anonymous label, or a reference to one: `:`, `:-`, `:++`."
			}
		],
		"semanticTokenScopes": [
			{
				"language": "tsasm",
				"scopes": {
					"label": [
						"entity.name.function.label.tsasm"
					],
					"label.local": [
						"variable.other.label.local.tsasm"
					],
					"label.local.declaration": [
						"entity.name.function.label.local.tsasm"
					],
					"label.anonymous": [
						"variable.other.label.anonymous.tsasm"
					],
					"label.anonymous.declaration": [
						"entity.name.function.label.anonymous.tsasm"
					],
					"variable": [
						"variable.other.tsasm"
					],
					"variable.readonly": [
						"variable.other.constant.tsasm"
					],
					"function": [
						"entity.name.function.tsasm"
					],
					"parameter": [
						"variable.parameter.tsasm"
					],
					"macro": [
						"entity.name.function.macro.tsasm"
					]
				}
			}
		]
	},
	"activationEvents": [
		"workspaceContains:**/*.asm"
	],
	"engines": {
		"vscode": "^1.75.0"
	}
}
